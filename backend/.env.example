ADDR=:8080
LOG_LEVEL=info
DATABASE_PATH=pollux.db
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_FILE=/path/to/pollux-agent.private-key.pem
GITHUB_WEBHOOK_SECRET=changeme

# Optional: set LLM_PROVIDER to turn on the analysis runner. Unset (the
# default) leaves it off, and repos without the pollux-agent workflow get a
# neutral "No analysis runner configured" check.
#
# anthropic:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-changeme
# LLM_MODEL=claude-sonnet-5
# LLM_TRIAGE_MODEL=claude-haiku-4-5-20251001
#
# Gemini free tier (key: https://aistudio.google.com/apikey). The free tier may
# train on inputs: sandbox repos only.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=changeme
# LLM_MODEL=gemini-3.7-flash
# LLM_TRIAGE_MODEL=gemini-3.5-flash-lite
#
# openai-compatible (Gemini, OpenRouter, Ollama):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-changeme
# LLM_MODEL=gpt-4o
# LLM_TRIAGE_MODEL=gpt-4o-mini

# Optional: `make eval` only, never read by the server (see docs/guides/eval.md).
# EVAL_RUNNER=actions
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-changeme
# EVAL_RUNS=3
# EVAL_PARALLEL=2
# EVAL_CASE=prune-jobs,manual-deploy
# EVAL_JUDGE_MODEL=
